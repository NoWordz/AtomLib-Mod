# Resource-pack assets and the manifest that pins their bytes must survive
# checkout byte-exact; autocrlf on Windows runners turned sounds.json into
# CRLF and broke the sha256 manifest check.
platforms/shared/src/main/resources/assets/** -text
# Command logs are raw evidence; retain their original line endings.
docs/evidence/**/*.log.txt -text
# This recipe runs under Linux Bash, including from Windows checkouts in WSL.
tools/build_android_yoga.sh text eol=lf
